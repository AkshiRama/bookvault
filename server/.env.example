# ============================================================
# BookVault — Server Environment Variables
# ============================================================
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# ============================================================

# -----------------------------------------------------------
# Server
# -----------------------------------------------------------
PORT=5000
NODE_ENV=development        # change to "production" on your host

# -----------------------------------------------------------
# MongoDB
# -----------------------------------------------------------
# LOCAL (embedded fallback used if this is unset or unreachable):
# MONGO_URI=mongodb://127.0.0.1:27017/bookvault

# ATLAS (production — replace with your Atlas connection string):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bookvault?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/bookvault

# -----------------------------------------------------------
# JWT
# -----------------------------------------------------------
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret_64_chars_minimum
JWT_EXPIRE=7d

# -----------------------------------------------------------
# CORS — allowed frontend origin(s)
# -----------------------------------------------------------
# LOCAL:
CLIENT_URL=http://localhost:5173

# PRODUCTION (your deployed Vercel URL):
# CLIENT_URL=https://bookvault.vercel.app

# Multiple origins (comma-separated):
# CLIENT_URL=https://bookvault.vercel.app,https://www.bookvault.com
