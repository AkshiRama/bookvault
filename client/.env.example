# ============================================================
# BookVault — Frontend Environment Variables
# ============================================================
#
# Copy this file to .env.local for local development.
# Vite automatically loads .env.local (not .env.example).
#
# IMPORTANT: Only variables prefixed with VITE_ are exposed
# to the browser bundle. Do NOT put secrets here.
#
# ============================================================

# -----------------------------------------------------------
# VITE_API_URL — Backend API base URL
# -----------------------------------------------------------
#
# LOCAL DEV (default — leave this commented out):
#   The Vite dev server proxies /api -> http://localhost:5000
#   so you do NOT need to set this locally.
#
# SAME-HOST PRODUCTION (backend serves frontend):
#   Leave this commented out. The relative /api path works
#   because Express static-serves the React build.
#
# CROSS-ORIGIN PRODUCTION (frontend on Vercel, backend on Railway):
#   Uncomment and set to your deployed backend URL:
#
# VITE_API_URL=https://bookvault-api.railway.app/api
